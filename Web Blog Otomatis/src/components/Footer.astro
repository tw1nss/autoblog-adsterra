---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const today = new Date();
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const footerPosts = allPosts.slice(0, 3);
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-main-grid">
			<!-- Col 1: About Portal -->
			<div class="footer-col">
				<div class="footer-logo">
					<span class="logo-main">NGULIK</span><span class="logo-accent">CUY</span><span class="logo-dot">.COM</span>
				</div>
				<p class="footer-about-text">
					Media digital terdepan untuk pegiat teknologi dan kreator yang gemar ngulik inovasi kecerdasan buatan (AI), tutorial coding & web dev, review gadget, serta strategi digital terkini.
				</p>
				<div class="footer-social-links">
					<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.688 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"/></svg>
					</a>
					<a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
					</a>
					<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</a>
					<a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
					</a>
				</div>
			</div>

			<!-- Col 2: Recent Posts -->
			<div class="footer-col">
				<h4 class="footer-title">Artikel Terbaru</h4>
				<div class="footer-posts-list">
					{footerPosts.map((post) => (
						<div class="footer-post-item">
							<a href={`/blog/${post.id}/`} class="footer-post-title">
								{post.data.title}
							</a>
							<span class="footer-post-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</div>
					))}
				</div>
			</div>

			<!-- Col 3: Quick Links & Categories -->
			<div class="footer-col">
				<h4 class="footer-title">Kategori & Topik</h4>
				<ul class="footer-links">
					<li><a href="/blog">AI & Machine Learning</a></li>
					<li><a href="/blog">Coding & Web Dev</a></li>
					<li><a href="/blog">Review & Tips Gadget</a></li>
					<li><a href="/blog">Bisnis & Marketing Digital</a></li>
					<li><a href="/about">Tentang Redaksi</a></li>
					<li><a href="/about">Pedoman Media Siber</a></li>
				</ul>
			</div>

			<!-- Col 4: Newsletter Subscription -->
			<div class="footer-col">
				<h4 class="footer-title">Newsletter Ngulik</h4>
				<p class="footer-text">
					Daftarkan email Anda untuk berlangganan rangkuman tips coding, update AI, dan ulasan gadget setiap minggunya.
				</p>
				<form class="footer-newsletter-form" onsubmit="event.preventDefault(); alert('Terima kasih telah bergabung!');">
					<input type="email" placeholder="Email Anda..." required class="footer-input" />
					<button type="submit" class="footer-btn">Daftar</button>
				</form>
			</div>
		</div>

		<!-- Footer Bottom Bar -->
		<div class="footer-bottom">
			<p class="copyright-text">
				&copy; {today.getFullYear()} <strong>Ngulikcuy.com</strong>. All rights reserved. Tempat ngulik teknologi & kreasi digital.
			</p>
			<ul class="footer-bottom-links">
				<li><a href="/about">Kebijakan Privasi</a></li>
				<li><a href="/about">Syarat & Ketentuan</a></li>
				<li><a href="/about">Kontak Kami</a></li>
			</ul>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: var(--dark-bg);
		color: #adb5bd;
		padding: 4rem 0 1.5rem 0;
		margin-top: auto;
		border-top: 4px solid var(--primary-red);
	}

	.footer-main-grid {
		display: grid;
		grid-template-columns: 1.3fr 1.1fr 0.9fr 1.1fr;
		gap: 2.5rem;
		margin-bottom: 3.5rem;
	}

	.footer-logo {
		margin-bottom: 1.25rem;
	}

	.footer-logo .logo-main {
		font-size: 1.85rem;
		font-weight: 900;
		color: #ffffff;
	}

	.footer-logo .logo-accent {
		font-size: 1.85rem;
		font-weight: 900;
		color: var(--primary-red);
	}

	.footer-logo .logo-dot {
		font-size: 1.85rem;
		font-weight: 900;
		color: var(--primary-red);
	}

	.footer-about-text {
		font-size: 0.88rem;
		line-height: 1.7;
		color: #94a3b8;
		margin-bottom: 1.5rem;
	}

	.footer-social-links {
		display: flex;
		gap: 0.75rem;
	}

	.footer-social-links a {
		width: 36px;
		height: 36px;
		background-color: var(--dark-surface);
		border: 1px solid var(--dark-border);
		color: #cbd5e1;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
		transition: all var(--transition-fast);
	}

	.footer-social-links a:hover {
		background-color: var(--primary-red);
		color: #ffffff;
		border-color: var(--primary-red);
		transform: translateY(-2px);
	}

	.footer-title {
		font-size: 1.1rem;
		font-weight: 800;
		text-transform: uppercase;
		color: #ffffff;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		position: relative;
		letter-spacing: 0.5px;
	}

	.footer-title::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 35px;
		height: 2px;
		background-color: var(--primary-red);
	}

	.footer-posts-list {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.footer-post-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		padding-bottom: 0.8rem;
	}

	.footer-post-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.footer-post-title {
		color: #e2e8f0;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.footer-post-title:hover {
		color: var(--primary-red);
	}

	.footer-post-date {
		font-size: 0.75rem;
		color: #64748b;
	}

	.footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-links li a {
		color: #94a3b8;
		font-size: 0.88rem;
		display: inline-block;
		transition: all var(--transition-fast);
	}

	.footer-links li a:hover {
		color: #ffffff;
		transform: translateX(4px);
	}

	.footer-text {
		font-size: 0.88rem;
		line-height: 1.6;
		color: #94a3b8;
		margin-bottom: 1.25rem;
	}

	.footer-newsletter-form {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-input {
		padding: 0.75rem 1rem;
		background-color: var(--dark-surface);
		border: 1px solid var(--dark-border);
		color: #ffffff;
		border-radius: var(--radius-sm);
		outline: none;
		font-size: 0.88rem;
	}

	.footer-input:focus {
		border-color: var(--primary-red);
	}

	.footer-btn {
		background-color: var(--primary-red);
		color: #ffffff;
		border: none;
		padding: 0.75rem 1rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		font-size: 0.85rem;
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition: background-color var(--transition-fast);
	}

	.footer-btn:hover {
		background-color: var(--primary-red-hover);
	}

	.footer-bottom {
		border-top: 1px solid var(--dark-border);
		padding-top: 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.82rem;
		color: #64748b;
	}

	.copyright-text strong {
		color: #e2e8f0;
	}

	.footer-bottom-links {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-bottom-links li a {
		color: #64748b;
		transition: color var(--transition-fast);
	}

	.footer-bottom-links li a:hover {
		color: #ffffff;
	}

	@media (max-width: 992px) {
		.footer-main-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}
	}

	@media (max-width: 600px) {
		.footer-main-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
		.footer-bottom-links {
			justify-content: center;
			flex-wrap: wrap;
			gap: 1rem;
		}
	}
</style>
