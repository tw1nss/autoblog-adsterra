---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts?: CollectionEntry<'blog'>[];
}

const { posts = [] } = Astro.props;

// Take up to 5 posts for trending widget
const trendingPosts = posts.slice(0, 5);

const categories = [
	{ name: 'AI & Machine Learning', count: 28 },
	{ name: 'Coding & Web Dev', count: 35 },
	{ name: 'Gadget & Hardware', count: 19 },
	{ name: 'Tips & Tutorial Digital', count: 24 },
	{ name: 'Bisnis & Startup Tech', count: 16 },
	{ name: 'Keamanan Siber & Cloud', count: 12 }
];
---

<aside class="sidebar-container">
	<!-- Social Follow Widget -->
	<div class="sidebar-widget">
		<h3 class="widget-title">Ikuti Kami</h3>
		<div class="social-follow-grid">
			<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-follow-btn fb">
				<span>Facebook</span>
			</a>
			<a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-follow-btn tw">
				<span>Twitter</span>
			</a>
			<a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-follow-btn yt">
				<span>YouTube</span>
			</a>
			<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-follow-btn ig">
				<span>Instagram</span>
			</a>
		</div>
	</div>

	<!-- Trending Posts Widget -->
	{trendingPosts.length > 0 && (
		<div class="sidebar-widget">
			<h3 class="widget-title">Berita Terpopuler</h3>
			<div class="trending-list">
				{trendingPosts.map((post, index) => (
					<div class="trending-numbered-item">
						<div class="trending-number">0{index + 1}</div>
						<div class="trending-content">
							<h4 class="trending-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h4>
							<div class="trending-meta">
								<FormattedDate date={post.data.pubDate} />
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	)}

	<!-- Ad / Banner in Sidebar -->
	<div class="sidebar-widget" style="padding: 1rem 0.5rem; text-align: center; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
		<span style="font-size: 0.7rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 0.5rem;">Sponsor / Iklan</span>
		<div class="sidebar-ad-wrapper" style="min-height: 60px; display: flex; align-items: center; justify-content: center;">
			<script is:inline>
				atOptions = {
					'key' : '52d4d03a465da574959d5a2f94fc0f1e',
					'format' : 'iframe',
					'height' : 50,
					'width' : 320,
					'params' : {}
				};
			</script>
			<script is:inline src="https://www.highrevenueformat.com/52d4d03a465da574959d5a2f94fc0f1e/invoke.js"></script>
		</div>
	</div>

	<!-- Categories Widget -->
	<div class="sidebar-widget">
		<h3 class="widget-title">Kategori Berita</h3>
		<div class="category-list">
			{categories.map((cat) => (
				<a href="/blog" class="category-list-item">
					<span>{cat.name}</span>
					<span class="category-count">{cat.count}</span>
				</a>
			))}
		</div>
	</div>

	<!-- Newsletter Widget -->
	<div class="newsletter-box">
		<h4>Newsletter Ngulik Tech</h4>
		<p>Dapatkan rangkuman panduan coding, update AI, dan tips teknologi terpopuler langsung ke email Anda setiap minggu.</p>
		<form class="newsletter-form" onsubmit="event.preventDefault(); alert('Terima kasih telah bergabung dengan komunitas Ngulikcuy!');">
			<input type="email" placeholder="Alamat email Anda..." required class="newsletter-input" />
			<button type="submit" class="newsletter-btn">Gabung Komunitas</button>
		</form>
	</div>
</aside>
