---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Sidebar from '../components/Sidebar.astro';
import PostCard from '../components/PostCard.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// Fetch all posts for sidebar and related articles
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const relatedPosts = allPosts
	.filter((p) => p.data.title !== title)
	.slice(0, 3);
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={`${title} - Ngulikcuy.com`} description={description} />
		<!-- Schema.org JSON-LD Structured Data for Google Rich Snippets -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "NewsArticle",
			"headline": title,
			"description": description,
			"image": typeof heroImage === 'string' ? heroImage : "https://ngulikcuy.com/blog-placeholder-1.jpg",
			"datePublished": pubDate.toISOString(),
			"dateModified": (updatedDate || pubDate).toISOString(),
			"author": {
				"@type": "Organization",
				"name": "Tim Redaksi Ngulikcuy",
				"url": "https://ngulikcuy.com/about"
			},
			"publisher": {
				"@type": "Organization",
				"name": "Ngulikcuy.com",
				"logo": {
					"@type": "ImageObject",
					"url": "https://ngulikcuy.com/favicon.svg"
				}
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": Astro.url.href
			}
		})} />
		<style>
			.article-page-wrapper {
				padding: 1.5rem 0 4rem 0;
			}

			.article-layout {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 2.25rem;
			}

			/* Social Share Bar */
			.article-share-bar {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 1.25rem 0;
				margin: 1.5rem 0 2rem 0;
				border-top: 1px solid var(--border-light);
				border-bottom: 1px solid var(--border-light);
				flex-wrap: wrap;
			}

			.share-label {
				font-size: 0.85rem;
				font-weight: 700;
				text-transform: uppercase;
				color: var(--text-primary);
				margin-right: 0.5rem;
			}

			.share-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.45rem 0.85rem;
				font-size: 0.8rem;
				font-weight: 700;
				border-radius: var(--radius-sm);
				color: #ffffff;
				transition: opacity var(--transition-fast);
			}

			.share-btn:hover {
				opacity: 0.9;
				color: #ffffff;
			}

			.share-btn.fb { background-color: #3b5998; }
			.share-btn.tw { background-color: #1da1f2; }
			.share-btn.wa { background-color: #25d366; }
			.share-btn.tg { background-color: #0088cc; }

			/* Author / Redaksi Box */
			.author-box {
				display: flex;
				align-items: center;
				gap: 1.25rem;
				background-color: var(--body-bg);
				border-radius: var(--radius-sm);
				padding: 1.5rem;
				margin: 2.5rem 0;
				border-left: 4px solid var(--primary-red);
			}

			.author-avatar {
				width: 60px;
				height: 60px;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--primary-red), #9b001a);
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: 800;
				font-size: 1.3rem;
				flex-shrink: 0;
			}

			.author-info h4 {
				margin-bottom: 0.25rem;
				font-size: 1.05rem;
			}

			.author-info p {
				font-size: 0.88rem;
				color: var(--text-secondary);
				margin: 0;
			}

			/* Related Posts Section */
			.related-section {
				margin-top: 3.5rem;
				padding-top: 2rem;
				border-top: 2px solid var(--border-light);
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}

			@media (max-width: 992px) {
				.article-layout {
					grid-template-columns: 1fr;
				}
				.related-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 600px) {
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="article-page-wrapper">
			<div class="container">
				<!-- Breadcrumbs -->
				<nav class="breadcrumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span class="separator">/</span>
					<a href="/blog">Berita</a>
					<span class="separator">/</span>
					<span class="current" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{title}</span>
				</nav>

				<div class="article-layout">
					<!-- Main Article Column -->
					<div class="article-main-column">
						<article class="article-container">
							<!-- Article Header -->
							<header class="article-header">
								<CategoryBadge category="BERITA UTAMA" />
								<h1>{title}</h1>
								
								<div class="article-meta">
									<div class="article-meta-item">
										<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
										<span>Oleh <strong>Tim Redaksi</strong></span>
									</div>
									<div class="article-meta-item">
										<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
										<span><FormattedDate date={pubDate} /></span>
									</div>
									{updatedDate && (
										<div class="article-meta-item">
											<em>(Diperbarui: <FormattedDate date={updatedDate} />)</em>
										</div>
									)}
								</div>
							</header>

							<!-- Featured Image -->
							{heroImage && (
								<div class="article-featured-image">
									{typeof heroImage !== 'string' ? (
										<Image width={1000} height={520} src={heroImage} alt={title} />
									) : (
										<img src={heroImage} alt={title} />
									)}
								</div>
							)}

							<!-- Social Share Top -->
							<div class="article-share-bar">
								<span class="share-label">Bagikan:</span>
								<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn fb">Facebook</a>
								<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn tw">Twitter</a>
								<a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn wa">WhatsApp</a>
								<a href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="share-btn tg">Telegram</a>
							</div>

							<!-- Body Content (Markdown / AI Articles) -->
							<div class="article-content">
								<slot />
							</div>

							<!-- ADSTERRA NATIVE BANNER (Preserved per Project Rules) -->
							<div class="adsterra-banner-slot" style="margin: 2.5rem 0; padding: 1rem 0; border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light); text-align: center;">
								<script async="async" data-cfasync="false" src="https://pl27934130.profitableratecpmnetwork.com/329aa93819f4d90acdf94d61de521167/invoke.js"></script>
								<div id="container-329aa93819f4d90acdf94d61de521167"></div>
							</div>

							<!-- Author Bio Box -->
							<div class="author-box">
								<div class="author-avatar">NC</div>
								<div class="author-info">
									<h4>Tim Redaksi Ngulikcuy</h4>
									<p>Komunitas dan tim kurasi konten teknologi independen yang berfokus menyajikan panduan praktis, riset AI terkini, tips coding, dan ulasan gadget yang aplikatif.</p>
								</div>
							</div>
						</article>

						<!-- Related Articles Section -->
						{relatedPosts.length > 0 && (
							<section class="related-section">
								<div class="section-header">
									<h3 class="section-title">Berita Terkait Lainnya</h3>
								</div>
								<div class="related-grid">
									{relatedPosts.map((rPost, idx) => (
										<PostCard
											title={rPost.data.title}
											pubDate={rPost.data.pubDate}
											heroImage={rPost.data.heroImage}
											slug={rPost.id}
											description={rPost.data.description}
											category={idx === 0 ? 'TERKAIT' : idx === 1 ? 'UPDATE' : 'POPOULER'}
											variant="grid"
										/>
									))}
								</div>
							</section>
						)}
					</div>

					<!-- Sidebar -->
					<Sidebar posts={allPosts} />
				</div>
			</div>
		</main>

		<Footer />

		<!-- ADSTERRA SOCIAL BAR (Preserved per Project Rules) -->
		<script src="https://pl31095563.profitableratecpmnetwork.com/14/d4/a7/14d4a72b2b46e945992c3798caea44dc.js"></script>
	</body>
</html>