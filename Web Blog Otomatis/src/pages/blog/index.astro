---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['TEKNOLOGI', 'BISNIS', 'NASIONAL', 'FINANSIAL', 'KESEHATAN', 'LIFESTYLE', 'OTOMOTIF'];
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={`Indeks Berita & Artikel - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-wrapper {
				padding: 1.5rem 0 4rem 0;
			}

			.page-header-banner {
				background-color: var(--card-bg);
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-sm);
				padding: 1.75rem;
				margin-bottom: 2rem;
				box-shadow: var(--shadow-subtle);
			}

			.page-title {
				font-size: 1.85rem;
				font-weight: 900;
				margin-bottom: 0.5rem;
				color: var(--text-primary);
			}

			.page-subtitle {
				font-size: 0.95rem;
				color: var(--text-secondary);
				margin-bottom: 0;
			}

			.archive-layout {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 2.25rem;
			}

			.archive-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				margin-bottom: 2.5rem;
			}

			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				margin-top: 2rem;
			}

			.page-num {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 38px;
				height: 38px;
				background-color: var(--card-bg);
				border: 1px solid var(--border-light);
				border-radius: var(--radius-sm);
				font-weight: 700;
				font-size: 0.9rem;
				color: var(--text-primary);
				transition: all var(--transition-fast);
			}

			.page-num:hover, .page-num.active {
				background-color: var(--primary-red);
				color: #ffffff;
				border-color: var(--primary-red);
			}

			@media (max-width: 992px) {
				.archive-layout {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.archive-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="page-wrapper">
			<div class="container">
				<!-- Breadcrumbs -->
				<nav class="breadcrumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span class="separator">/</span>
					<span class="current">Indeks Berita</span>
				</nav>

				<!-- Page Header -->
				<div class="page-header-banner">
					<h1 class="page-title">Arsip Berita & Publikasi</h1>
					<p class="page-subtitle">Kumpulan berita, analisis, dan artikel pilihan dari berbagai topik dan kategori terkini.</p>
				</div>

				<!-- Main Archive Layout -->
				<div class="archive-layout">
					<!-- Post Grid -->
					<div class="archive-main">
						<div class="archive-grid">
							{posts.map((post, idx) => (
								<PostCard
									title={post.data.title}
									pubDate={post.data.pubDate}
									heroImage={post.data.heroImage}
									slug={post.id}
									description={post.data.description}
									category={categories[idx % categories.length]}
									variant="grid"
								/>
							))}
						</div>

						<!-- Simple Pagination Bar -->
						<div class="pagination">
							<a href="#" class="page-num active">1</a>
							<a href="#" class="page-num">2</a>
							<a href="#" class="page-num">3</a>
							<a href="#" class="page-num" aria-label="Next Page">&rarr;</a>
						</div>
					</div>

					<!-- Sidebar -->
					<Sidebar posts={posts} />
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
