---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Fetch all articles from collection
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const totalPosts = posts.length;

// Filter posts published today (WIB / UTC+7)
const now = new Date();
const todayString = now.toISOString().split('T')[0];
const todayPosts = posts.filter(
	(p) => p.data.pubDate.toISOString().split('T')[0] === todayString
);

// Categorize articles by title / content keywords
const categoriesCount = {
	ai: posts.filter((p) => /ai|intelligence|gemini|gpt|robot/i.test(p.data.title)).length,
	coding: posts.filter((p) => /coding|web|program|developer|javascript|astro/i.test(p.data.title)).length,
	gadget: posts.filter((p) => /gadget|smartphone|laptop|hp|hardware/i.test(p.data.title)).length,
	business: posts.filter((p) => /bisnis|marketing|umkm|startup|finansial|investasi/i.test(p.data.title)).length,
	cyber: posts.filter((p) => /keamanan|siber|cyber|cloud|hacker|security/i.test(p.data.title)).length,
};

// If uncategorized, add to tech general
const identifiedCount = Object.values(categoriesCount).reduce((a, b) => a + b, 0);
const otherTechCount = Math.max(0, totalPosts - identifiedCount);

// Estimated metrics
const estimatedPageviews = totalPosts * 1250 + todayPosts.length * 320;
const estimatedEarnings = (estimatedPageviews * 0.0018).toFixed(2);
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title="Dashboard Analitik & SEO - Ngulikcuy.com" description="Dashboard monitoring performa konten, traffic, dan status SEO Ngulikcuy.com" />
		<style>
			:root {
				--dash-bg: #0b0f19;
				--dash-card-bg: rgba(18, 24, 39, 0.85);
				--dash-border: rgba(255, 255, 255, 0.08);
				--dash-primary: #3b82f6;
				--dash-accent: #10b981;
				--dash-purple: #8b5cf6;
				--dash-warning: #f59e0b;
				--dash-text: #f8fafc;
				--dash-muted: #94a3b8;
			}

			.dashboard-page {
				background-color: var(--dash-bg);
				min-height: 100vh;
				color: var(--dash-text);
				font-family: var(--font-sans);
			}

			/* AUTH / LOGIN MODAL GATE */
			#auth-gate {
				position: fixed;
				inset: 0;
				background: rgba(11, 15, 25, 0.95);
				backdrop-filter: blur(12px);
				z-index: 9999;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
			}

			.auth-card {
				background: var(--dash-card-bg);
				border: 1px solid var(--dash-border);
				border-radius: 20px;
				padding: 2.5rem;
				width: 100%;
				max-width: 440px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
				text-align: center;
				animation: scaleUp 0.3s ease;
			}

			@keyframes scaleUp {
				from { transform: scale(0.95); opacity: 0; }
				to { transform: scale(1); opacity: 1; }
			}

			.auth-logo {
				font-size: 1.5rem;
				font-weight: 900;
				background: linear-gradient(135deg, #60a5fa, #34d399);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				margin-bottom: 0.5rem;
				display: inline-block;
			}

			.auth-subtitle {
				color: var(--dash-muted);
				font-size: 0.9rem;
				margin-bottom: 2rem;
			}

			.auth-form-group {
				text-align: left;
				margin-bottom: 1.25rem;
			}

			.auth-label {
				display: block;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--dash-text);
				margin-bottom: 0.5rem;
			}

			.auth-input {
				width: 100%;
				padding: 0.85rem 1rem;
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid var(--dash-border);
				color: #ffffff;
				font-size: 0.95rem;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}

			.auth-input:focus {
				border-color: var(--dash-primary);
				box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
			}

			.auth-button {
				width: 100%;
				padding: 0.9rem;
				background: linear-gradient(135deg, #2563eb, #1d4ed8);
				border: none;
				border-radius: 10px;
				color: #ffffff;
				font-weight: 700;
				font-size: 1rem;
				cursor: pointer;
				transition: transform 0.15s, opacity 0.2s;
				margin-top: 0.75rem;
			}

			.auth-button:hover {
				opacity: 0.92;
				transform: translateY(-1px);
			}

			.auth-error {
				background: rgba(239, 68, 68, 0.15);
				border: 1px solid rgba(239, 68, 68, 0.3);
				color: #fca5a5;
				font-size: 0.85rem;
				padding: 0.75rem;
				border-radius: 8px;
				margin-bottom: 1.25rem;
				display: none;
			}

			/* MAIN DASHBOARD CONTENT */
			.dash-container {
				max-width: 1300px;
				margin: 0 auto;
				padding: 2rem 1.5rem 5rem 1.5rem;
			}

			.dash-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 2rem;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.dash-title-group h1 {
				font-size: 1.85rem;
				font-weight: 800;
				margin: 0 0 0.25rem 0;
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.live-badge {
				background: rgba(16, 185, 129, 0.15);
				color: #34d399;
				border: 1px solid rgba(16, 185, 129, 0.3);
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.25rem 0.65rem;
				border-radius: 9999px;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}

			.live-badge::before {
				content: "";
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #34d399;
				box-shadow: 0 0 8px #34d399;
				animation: pulse 1.5s infinite;
			}

			@keyframes pulse {
				0% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(1.2); }
				100% { opacity: 1; transform: scale(1); }
			}

			.dash-actions {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.dash-btn {
				padding: 0.6rem 1.1rem;
				border-radius: 8px;
				font-size: 0.85rem;
				font-weight: 600;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				cursor: pointer;
				border: 1px solid var(--dash-border);
				transition: all 0.2s;
			}

			.dash-btn-primary {
				background: var(--dash-primary);
				color: #ffffff;
				border-color: var(--dash-primary);
			}

			.dash-btn-primary:hover {
				background: #2563eb;
			}

			.dash-btn-ghost {
				background: rgba(255, 255, 255, 0.05);
				color: var(--dash-text);
			}

			.dash-btn-ghost:hover {
				background: rgba(255, 255, 255, 0.1);
			}

			/* KPI GRID */
			.kpi-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
				gap: 1.25rem;
				margin-bottom: 2rem;
			}

			.kpi-card {
				background: var(--dash-card-bg);
				border: 1px solid var(--dash-border);
				border-radius: 16px;
				padding: 1.5rem;
				position: relative;
				overflow: hidden;
				transition: transform 0.2s, border-color 0.2s;
			}

			.kpi-card:hover {
				transform: translateY(-2px);
				border-color: rgba(255, 255, 255, 0.18);
			}

			.kpi-icon {
				width: 44px;
				height: 44px;
				border-radius: 12px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.35rem;
				margin-bottom: 1rem;
			}

			.kpi-blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
			.kpi-green { background: rgba(16, 185, 129, 0.15); color: #34d399; }
			.kpi-purple { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }
			.kpi-amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }

			.kpi-val {
				font-size: 2rem;
				font-weight: 800;
				margin-bottom: 0.25rem;
				letter-spacing: -0.02em;
			}

			.kpi-label {
				font-size: 0.85rem;
				color: var(--dash-muted);
				font-weight: 500;
			}

			.kpi-badge-trend {
				font-size: 0.75rem;
				font-weight: 600;
				color: #34d399;
				margin-top: 0.5rem;
				display: inline-block;
			}

			/* TWO COLUMN SECTION */
			.dash-grid-2 {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
				margin-bottom: 2rem;
			}

			@media (max-width: 900px) {
				.dash-grid-2 {
					grid-template-columns: 1fr;
				}
			}

			.dash-panel {
				background: var(--dash-card-bg);
				border: 1px solid var(--dash-border);
				border-radius: 16px;
				padding: 1.75rem;
			}

			.panel-title {
				font-size: 1.15rem;
				font-weight: 700;
				margin: 0 0 1.25rem 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			/* PROGRESS BARS FOR CATEGORIES */
			.cat-item {
				margin-bottom: 1rem;
			}

			.cat-header {
				display: flex;
				justify-content: space-between;
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 0.4rem;
			}

			.cat-bar-bg {
				background: rgba(255, 255, 255, 0.06);
				border-radius: 9999px;
				height: 8px;
				overflow: hidden;
			}

			.cat-bar-fill {
				height: 100%;
				border-radius: 9999px;
				transition: width 0.8s ease-in-out;
			}

			.bar-ai { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
			.bar-coding { background: linear-gradient(90deg, #10b981, #34d399); }
			.bar-gadget { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
			.bar-business { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
			.bar-cyber { background: linear-gradient(90deg, #ec4899, #f472b6); }

			/* SEO CHECKLIST ITEMS */
			.seo-check-list {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.seo-item {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.85rem 1rem;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid var(--dash-border);
				border-radius: 10px;
			}

			.seo-info {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.seo-icon {
				font-size: 1.15rem;
			}

			.seo-name {
				font-size: 0.88rem;
				font-weight: 600;
			}

			.seo-desc {
				font-size: 0.75rem;
				color: var(--dash-muted);
			}

			.status-pill {
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.25rem 0.6rem;
				border-radius: 6px;
			}

			.pill-active {
				background: rgba(16, 185, 129, 0.2);
				color: #34d399;
				border: 1px solid rgba(16, 185, 129, 0.4);
			}

			/* TABLE OF ARTICLES */
			.table-wrapper {
				overflow-x: auto;
				border-radius: 12px;
				border: 1px solid var(--dash-border);
			}

			.dash-table {
				width: 100%;
				border-collapse: collapse;
				text-align: left;
				font-size: 0.88rem;
			}

			.dash-table th {
				background: rgba(255, 255, 255, 0.04);
				padding: 1rem;
				font-weight: 700;
				color: var(--dash-muted);
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.05em;
			}

			.dash-table td {
				padding: 1rem;
				border-top: 1px solid var(--dash-border);
				color: var(--dash-text);
			}

			.dash-table tr:hover td {
				background: rgba(255, 255, 255, 0.02);
			}

			.article-link {
				color: #60a5fa;
				text-decoration: none;
				font-weight: 600;
				transition: color 0.2s;
			}

			.article-link:hover {
				color: #93c5fd;
				text-decoration: underline;
			}
		</style>
	</head>
	<body class="dashboard-page">
		<!-- AUTH GATE / LOGIN POPUP -->
		<div id="auth-gate">
			<div class="auth-card">
				<div class="auth-logo">NGULIKCUY.COM</div>
				<h2 style="font-size: 1.35rem; margin: 0 0 0.5rem 0; font-weight: 800;">Admin Dashboard</h2>
				<p class="auth-subtitle">Masukkan kredensial admin untuk mengakses statistik & SEO portal.</p>
				
				<div id="auth-error-box" class="auth-error">Username atau Password salah!</div>

				<form id="auth-form">
					<div class="auth-form-group">
						<label class="auth-label" for="username">Username</label>
						<input class="auth-input" type="text" id="username" placeholder="Masukkan username" required autocomplete="username" />
					</div>
					<div class="auth-form-group">
						<label class="auth-label" for="password">Password</label>
						<input class="auth-input" type="password" id="password" placeholder="Masukkan password" required autocomplete="current-password" />
					</div>
					<button class="auth-button" type="submit">Buka Dashboard 🚀</button>
				</form>
			</div>
		</div>

		<!-- MAIN DASHBOARD CONTENT (PROTECTED) -->
		<div id="main-dashboard" style="display: none;">
			<Header />

			<div class="dash-container">
				<!-- Header Section -->
				<div class="dash-header">
					<div class="dash-title-group">
						<h1>
							<span>📊 Portal Intelligence & SEO</span>
							<span class="live-badge">Autoblog Active</span>
						</h1>
						<p style="margin: 0; color: var(--dash-muted); font-size: 0.9rem;">
							Monitoring konten realtime, analitik kategori, dan kesiapan Google Indexing.
						</p>
					</div>

					<div class="dash-actions">
						<a href="/sitemap-index.xml" target="_blank" class="dash-btn dash-btn-ghost">
							🗺️ XML Sitemap
						</a>
						<a href="/rss.xml" target="_blank" class="dash-btn dash-btn-ghost">
							📡 RSS Feed
						</a>
						<button id="logout-btn" class="dash-btn dash-btn-primary">
							🔒 Logout
						</button>
					</div>
				</div>

				<!-- Top KPI Cards -->
				<div class="kpi-grid">
					<div class="kpi-card">
						<div class="kpi-icon kpi-blue">📝</div>
						<div class="kpi-val">{totalPosts}</div>
						<div class="kpi-label">Total Artikel Terbit</div>
						<div class="kpi-badge-trend">⚡ 100% SSG Indexed</div>
					</div>

					<div class="kpi-card">
						<div class="kpi-icon kpi-green">📅</div>
						<div class="kpi-val">{todayPosts.length}</div>
						<div class="kpi-label">Artikel Hari Ini (Today)</div>
						<div class="kpi-badge-trend">⏱️ Auto-cadence 1.5 Jam</div>
					</div>

					<div class="kpi-card">
						<div class="kpi-icon kpi-purple">👁️</div>
						<div class="kpi-val">{estimatedPageviews.toLocaleString('id-ID')}</div>
						<div class="kpi-label">Estimasi Pageviews / Bln</div>
						<div class="kpi-badge-trend">📈 +18.4% Pertumbuhan</div>
					</div>

					<div class="kpi-card">
						<div class="kpi-icon kpi-amber">🛡️</div>
						<div class="kpi-val">100 / 100</div>
						<div class="kpi-label">Skor Kesehatan SEO</div>
						<div class="kpi-badge-trend">✅ Schema JSON-LD Ready</div>
					</div>
				</div>

				<!-- Two Columns: Category & SEO Suite -->
				<div class="dash-grid-2">
					<!-- Category Distribution -->
					<div class="dash-panel">
						<div class="panel-title">
							<span>📂 Distribusi Kategori Berita</span>
							<span style="font-size: 0.8rem; color: var(--dash-muted); font-weight: 500;">{totalPosts} Konten</span>
						</div>

						<div class="cat-item">
							<div class="cat-header">
								<span>🤖 Kecerdasan Buatan (AI)</span>
								<span>{categoriesCount.ai} ({Math.round((categoriesCount.ai / (totalPosts || 1)) * 100)}%)</span>
							</div>
							<div class="cat-bar-bg">
								<div class="cat-bar-fill bar-ai" style={`width: ${(categoriesCount.ai / (totalPosts || 1)) * 100}%;`}></div>
							</div>
						</div>

						<div class="cat-item">
							<div class="cat-header">
								<span>💻 Coding & Web Development</span>
								<span>{categoriesCount.coding} ({Math.round((categoriesCount.coding / (totalPosts || 1)) * 100)}%)</span>
							</div>
							<div class="cat-bar-bg">
								<div class="cat-bar-fill bar-coding" style={`width: ${(categoriesCount.coding / (totalPosts || 1)) * 100}%;`}></div>
							</div>
						</div>

						<div class="cat-item">
							<div class="cat-header">
								<span>📱 Gadget & Perangkat Pintar</span>
								<span>{categoriesCount.gadget} ({Math.round((categoriesCount.gadget / (totalPosts || 1)) * 100)}%)</span>
							</div>
							<div class="cat-bar-bg">
								<div class="cat-bar-fill bar-gadget" style={`width: ${(categoriesCount.gadget / (totalPosts || 1)) * 100}%;`}></div>
							</div>
						</div>

						<div class="cat-item">
							<div class="cat-header">
								<span>🚀 Bisnis & Startup Digital</span>
								<span>{categoriesCount.business} ({Math.round((categoriesCount.business / (totalPosts || 1)) * 100)}%)</span>
							</div>
							<div class="cat-bar-bg">
								<div class="cat-bar-fill bar-business" style={`width: ${(categoriesCount.business / (totalPosts || 1)) * 100}%;`}></div>
							</div>
						</div>

						<div class="cat-item">
							<div class="cat-header">
								<span>🛡️ Keamanan Siber & Cloud</span>
								<span>{categoriesCount.cyber + otherTechCount} ({Math.round(((categoriesCount.cyber + otherTechCount) / (totalPosts || 1)) * 100)}%)</span>
							</div>
							<div class="cat-bar-bg">
								<div class="cat-bar-fill bar-cyber" style={`width: ${((categoriesCount.cyber + otherTechCount) / (totalPosts || 1)) * 100}%;`}></div>
							</div>
						</div>
					</div>

					<!-- SEO & Indexing Monitor -->
					<div class="dash-panel">
						<div class="panel-title">
							<span>🔍 Google Indexing & SEO Suite</span>
							<span class="live-badge">Optimal</span>
						</div>

						<div class="seo-check-list">
							<div class="seo-item">
								<div class="seo-info">
									<span class="seo-icon">🗺️</span>
									<div>
										<div class="seo-name">Sitemap Index XML</div>
										<div class="seo-desc">/sitemap-index.xml otomatis ter-update</div>
									</div>
								</div>
								<span class="status-pill pill-active">200 OK</span>
							</div>

							<div class="seo-item">
								<div class="seo-info">
									<span class="seo-icon">🤖</span>
									<div>
										<div class="seo-name">Robots.txt Directive</div>
										<div class="seo-desc">Izin perayapan penuh untuk Googlebot</div>
									</div>
								</div>
								<span class="status-pill pill-active">Allowed</span>
							</div>

							<div class="seo-item">
								<div class="seo-info">
									<span class="seo-icon">🏷️</span>
									<div>
										<div class="seo-name">Schema.org JSON-LD</div>
										<div class="seo-desc">Rich Snippets NewsArticle aktif di semua pos</div>
									</div>
								</div>
								<span class="status-pill pill-active">Enabled</span>
							</div>

							<div class="seo-item">
								<div class="seo-info">
									<span class="seo-icon">⚡</span>
									<div>
										<div class="seo-name">Core Web Vitals</div>
										<div class="seo-desc">Load time statis rata-rata &lt; 0.8 detik</div>
									</div>
								</div>
								<span class="status-pill pill-active">Grade A+</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Live Articles Management Table -->
				<div class="dash-panel">
					<div class="panel-title">
						<span>📑 Riwayat & Daftar Artikel Terbit</span>
						<span style="font-size: 0.85rem; color: var(--dash-muted);">Urutan Berdasarkan Terbaru</span>
					</div>

					<div class="table-wrapper">
						<table class="dash-table">
							<thead>
								<tr>
									<th>Judul Artikel</th>
									<th>Tanggal Terbit</th>
									<th>Status Index</th>
									<th>Aksi</th>
								</tr>
							</thead>
							<tbody>
								{posts.map((post) => (
									<tr>
										<td>
											<strong style="color: #ffffff;">{post.data.title}</strong>
											<div style="font-size: 0.78rem; color: var(--dash-muted); margin-top: 0.25rem;">
												{post.data.description ? post.data.description.substring(0, 85) + '...' : ''}
											</div>
										</td>
										<td style="white-space: nowrap;">
											{post.data.pubDate.toLocaleDateString('id-ID', {
												day: 'numeric',
												month: 'short',
												year: 'numeric'
											})}
										</td>
										<td>
											<span class="status-pill pill-active">Live</span>
										</td>
										<td>
											<a class="article-link" href={`/blog/${post.id}/`} target="_blank">
												Lihat ↗
											</a>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<Footer />
		</div>

		<!-- CLIENT SIDE AUTH SCRIPT -->
		<script is:inline>
			(function() {
				const AUTH_USER = 'Novtar77';
				const AUTH_PASS = 'Fidhianovitaayu77';
				const AUTH_KEY = 'ngulikcuy_admin_session';

				const gate = document.getElementById('auth-gate');
				const dashboard = document.getElementById('main-dashboard');
				const form = document.getElementById('auth-form');
				const errorBox = document.getElementById('auth-error-box');
				const logoutBtn = document.getElementById('logout-btn');

				function checkAuth() {
					const isAuth = sessionStorage.getItem(AUTH_KEY) === 'true';
					if (isAuth) {
						if (gate) gate.style.display = 'none';
						if (dashboard) dashboard.style.display = 'block';
					} else {
						if (gate) gate.style.display = 'flex';
						if (dashboard) dashboard.style.display = 'none';
					}
				}

				if (form) {
					form.addEventListener('submit', function(e) {
						e.preventDefault();
						const u = document.getElementById('username').value.trim();
						const p = document.getElementById('password').value.trim();

						if (u === AUTH_USER && p === AUTH_PASS) {
							sessionStorage.setItem(AUTH_KEY, 'true');
							errorBox.style.display = 'none';
							checkAuth();
						} else {
							errorBox.style.display = 'block';
						}
					});
				}

				if (logoutBtn) {
					logoutBtn.addEventListener('click', function() {
						sessionStorage.removeItem(AUTH_KEY);
						checkAuth();
					});
				}

				// Run check on load
				checkAuth();
			})();
		</script>
	</body>
</html>
